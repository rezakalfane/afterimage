# AFTERIMAGE — environment variables (names and obviously fake examples only).
# Local: `npm run setup` creates .env.local with generated secrets. Never commit real values.
# Staging/production: set these in each Vercel project (separate values per environment).
# No secret may use the NEXT_PUBLIC_ prefix.

# local | staging | production (also part of the memory identity HMAC)
APP_ENV=local
# Exact public origin of this environment (Better Auth origin + Origin checks)
APP_URL=http://localhost:3000
# Optional, defaults to APP_URL
BETTER_AUTH_URL=
# >= 32 random chars, unique per environment
BETTER_AUTH_SECRET=replace-with-32+-random-characters
# local: file:./var/afterimage.db — staging/production: libsql://<db>.turso.io (never a file on Vercel)
DATABASE_URL=file:./var/afterimage.db
# remote libSQL token, environment-specific
DATABASE_AUTH_TOKEN=
# HMAC secret for Napster memory identities; STABLE per environment (rotation keeps stored ids)
MEMORY_ID_SECRET=replace-with-32+-random-characters
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=replace-with-24+-random-characters

# rehearsal (no Napster call, labelled) | live
CONVERSATION_MODE=rehearsal
# Napster (server only). Agent ids: see config/napster-resources.json
NAPSTER_API_KEY=
NAPSTER_JEANNE_AGENT_ID=
NAPSTER_MALIK_AGENT_ID=
# English agents (the player picks the language in Settings or with the FR|EN switch)
NAPSTER_JEANNE_AGENT_ID_EN=
NAPSTER_MALIK_AGENT_ID_EN=
# Concurrent conversations allowed in THIS environment. The org limit (5) is shared by all
# environments: keep the sum ≤ 5 (e.g. production 3, staging 1, local 1).
NAPSTER_MAX_ACTIVE=1
# Bonuses stay off until the capability is proven on the account
NAPSTER_RECORDINGS_ENABLED=false
NAPSTER_PHONE_ENABLED=false
# Slug of the public demo tenant (seeded)
PUBLIC_TENANT_SLUG=demo
