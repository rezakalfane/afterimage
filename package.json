{
  "name": "afterimage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AFTERIMAGE — La dernière séance. Two-era conversational mystery on the Napster API.",
  "scripts": {
    "setup": "tsx --conditions=react-server scripts/setup.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "doctor": "tsx --conditions=react-server scripts/doctor.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "auth:generate": "auth generate --config scripts/auth-schema.config.ts --output src/server/db/auth-schema.ts -y",
    "assets:build": "tsx --conditions=react-server scripts/assets-build.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build && npm run check:bundle",
    "provision:napster": "tsx --conditions=react-server scripts/provision-napster.ts",
    "ops:cleanup": "tsx --conditions=react-server scripts/ops-cleanup.ts",
    "ops:bootstrap-owner": "tsx --conditions=react-server scripts/ops-bootstrap-owner.ts",
    "release:migrate": "tsx --conditions=react-server scripts/release-migrate.ts",
    "ops:napster-usage": "tsx --conditions=react-server scripts/ops-napster-usage.ts",
    "check:bundle": "tsx scripts/check-bundle.ts"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@reduxjs/toolkit": "2.13.0",
    "@touchcastllc/napster-companion-api": "2.0.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
